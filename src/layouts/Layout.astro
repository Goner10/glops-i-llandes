---
import { Font } from "astro:assets";

import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { locales } from "../i18n/locale";
import type { Locale } from "../i18n/locale";
import {
  absolutePageUrl,
  localeHtmlLang,
  localeOg,
  type PageId,
} from "../i18n/routes";
import { ui } from "../i18n/ui";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  locale: Locale;
  page: PageId;
  title: string;
  description: string;
  /** Remate del header y del footer. La carta prescinde del damero. */
  strip?: "checker" | "rule";
  /** Header superpuesto al hero en la portada; en interiores arranca sólido. */
  compactHeader?: boolean;
}

const {
  locale,
  page,
  title,
  description,
  strip = "checker",
  compactHeader = false,
} = Astro.props;

const t = ui(locale);
const canonical = absolutePageUrl(locale, page);
---

<!doctype html>
<html lang={localeHtmlLang(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeOg(locale)} />
    {
      locales
        .filter((item) => item !== locale)
        .map((item) => <meta property="og:locale:alternate" content={localeOg(item)} />)
    }
    {canonical && <link rel="canonical" href={canonical} />}
    {
      locales.map((item) => {
        const href = absolutePageUrl(item, page);
        return href ? <link rel="alternate" hreflang={item} href={href} /> : null;
      })
    }
    {
      absolutePageUrl("es", page) && (
        <link rel="alternate" hreflang="x-default" href={absolutePageUrl("es", page)} />
      )
    }

    <Font cssVariable="--font-oswald" preload />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-plex-mono" />

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#contenido">{t.skipToContent}</a>
    <Header locale={locale} page={page} strip={strip} compact={compactHeader} />
    <slot />
    <!--
      Tras el slot: el hero ya está en el DOM. Evita un frame con el símbolo
      blanco sobre papel si la home carga ya scrolleada (ancla, historial).
    -->
    <script is:inline>
      (function () {
        var header = document.querySelector("[data-site-header][data-header-overlaid]");
        var hero = document.querySelector("[data-hero]");
        if (!header || !hero) return;
        if (hero.getBoundingClientRect().bottom <= header.offsetHeight) {
          header.classList.add("is-solid");
        }
        if (window.scrollY > 16) header.classList.add("is-compacted");
      })();
    </script>
    <Footer locale={locale} strip={strip} />

    <script>
      import { initReveal } from "../scripts/animations/reveal";

      initReveal();
    </script>
  </body>
</html>
