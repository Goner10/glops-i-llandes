---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Glops i Llandes, bar y restaurante en Paterna."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>