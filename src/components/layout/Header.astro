---
import { Image } from "astro:assets";

import logoIconBlack from "../../assets/images/brand/logo-negro-solo.png";
import logoIconWhite from "../../assets/images/brand/logo-blanco-solo.png";
import logoTextBlack from "../../assets/images/brand/texto-negro.png";
import logoTextWhite from "../../assets/images/brand/texto-blanco.png";
import { site } from "../../config/site";
import { withBase } from "../../lib/paths";

interface Props {
  /** Remate bajo la barra: damero en la portada, doble filete en la carta. */
  strip?: "checker" | "rule";
  /**
   * Home: el header móvil se superpone al hero y cambia de aspecto al salir de él.
   * En páginas interiores el estado sólido (papel + wordmark negro) es el de partida.
   */
  compact?: boolean;
}

const { strip = "checker", compact = false } = Astro.props;
const overlaid = compact;
---

<header
  class:list={["site-header", { "site-header--compact": compact, "site-header--overlaid": overlaid }]}
  data-site-header
  data-header-overlaid={overlaid ? "" : undefined}
>
  <div class="bar">
    <a class="brand" href={withBase("/")}>
      <span class="visually-hidden">{site.name}, inicio</span>
      <span class="brand__slot" aria-hidden="true">
        <Image
          class="brand__full brand__full--white"
          src={logoTextWhite}
          alt=""
          widths={[280, 440]}
          sizes="(min-width: 62rem) 212px, 58vw"
          loading="eager"
        />
        <Image
          class="brand__full brand__full--black"
          src={logoTextBlack}
          alt=""
          widths={[280, 440]}
          sizes="(min-width: 62rem) 212px, 58vw"
          loading="eager"
        />
        <Image
          class="brand__icon brand__icon--white"
          src={logoIconWhite}
          alt=""
          widths={[80, 120]}
          sizes="40px"
          loading="eager"
        />
        <Image
          class="brand__icon brand__icon--black"
          src={logoIconBlack}
          alt=""
          widths={[80, 120]}
          sizes="40px"
          loading="eager"
        />
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Navegación principal">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="phone" href={site.phone.href}>{site.phone.display}</a>
      <button
        class="burger"
        type="button"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-toggle
      >
        <span class="burger__lines" aria-hidden="true">
          <span class="burger__line"></span>
          <span class="burger__line"></span>
          <span class="burger__line"></span>
        </span>
        <span class="visually-hidden" data-menu-label>Abrir menú</span>
      </button>
    </div>
  </div>

  <!-- Velo sobre la página mientras el menú está abierto; tocarlo cuenta como «fuera». -->
  <div class="scrim" hidden data-menu-scrim aria-hidden="true"></div>

  <div class="panel" id="menu-movil" hidden data-menu-panel>
    <nav aria-label="Navegación móvil">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} data-menu-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn--brand panel__cta" href={site.phone.href}>
      Llamar {site.phone.display}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-paper);
  }

  .bar {
    /* Por encima del velo y del panel, para que el botón siga accesible con el menú abierto. */
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-m);
    width: 100%;
    max-width: var(--container);
    min-height: var(--header-height);
    margin-inline: auto;
    padding: 0.5rem var(--gutter);
    background: var(--color-paper);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    text-decoration: none;
  }

  /*
   * Hueco estable: en la home conserva el ancho del wordmark aunque se muestre
   * solo el dibujo, para que no salten la nav ni el botón del menú.
   */
  .brand__slot {
    position: relative;
    display: block;
    width: 3.5rem;
    height: 2.4rem;
  }

  .site-header--overlaid .brand__slot {
    width: min(13.25rem, 58vw);
    height: auto;
    aspect-ratio: 4419 / 844;
  }

  .brand :global(.brand__full),
  .brand :global(.brand__icon) {
    position: absolute;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.22s var(--ease-out),
      translate 0.22s var(--ease-out),
      scale 0.22s var(--ease-out),
      visibility 0.22s;
  }

  .brand :global(.brand__full) {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
    scale: 0.96;
    translate: 0 0.15rem;
  }

  .brand :global(.brand__icon) {
    top: 50%;
    left: 0;
    width: auto;
    height: 2.4rem;
    scale: 0.92;
    translate: 0 -40%;
  }

  /* Visible: carta/reservas y home compactada + papel. */
  .site-header:not(.site-header--overlaid) .brand :global(.brand__icon--black),
  .site-header--overlaid.is-compacted.is-solid .brand :global(.brand__icon--black),
  .site-header--overlaid.is-compacted.is-menu-open .brand :global(.brand__icon--black) {
    opacity: 1;
    visibility: visible;
    scale: 1;
    translate: 0 -50%;
  }

  /* Home arriba del todo, sobre el vídeo. */
  .site-header--overlaid:not(.is-compacted) .brand :global(.brand__full--white) {
    opacity: 1;
    visibility: visible;
    scale: 1;
    translate: 0;
  }

  /* Home arriba del todo con barra de papel (menú abierto). */
  .site-header--overlaid:not(.is-compacted).is-solid .brand :global(.brand__full--white),
  .site-header--overlaid:not(.is-compacted).is-menu-open .brand :global(.brand__full--white) {
    opacity: 0;
    visibility: hidden;
  }

  .site-header--overlaid:not(.is-compacted).is-solid .brand :global(.brand__full--black),
  .site-header--overlaid:not(.is-compacted).is-menu-open .brand :global(.brand__full--black) {
    opacity: 1;
    visibility: visible;
    scale: 1;
    translate: 0;
  }

  /* Home scrolleada, todavía sobre el vídeo. */
  .site-header--overlaid.is-compacted:not(.is-solid):not(.is-menu-open) .brand :global(.brand__icon--white) {
    opacity: 1;
    visibility: visible;
    scale: 1;
    translate: 0 -50%;
  }

  .site-header--compact .bar {
    padding-block: 0.35rem;
  }

  .nav-desktop {
    display: none;
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-desktop a {
    display: inline-block;
    padding: 0.35rem 0.5rem;
    border-bottom: 2px solid transparent;
    font-family: var(--font-mono);
    font-size: var(--text-s);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* Inversión: el mostaza como texto sobre papel no llega al contraste mínimo. */
  .nav-desktop a:hover {
    border-bottom-color: var(--color-black);
    background: var(--color-brand);
    color: var(--color-black);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .phone {
    display: none;
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-s);
    font-family: var(--font-mono);
    font-size: var(--text-s);
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .phone:hover {
    background: var(--color-brand);
    color: var(--color-black);
  }

  .burger {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 2px solid var(--color-black);
    border-radius: var(--radius-m);
    background: var(--color-paper);
    cursor: pointer;
  }

  /* Tres líneas que se convierten en cruz: la del medio desaparece y las otras giran. */
  .burger__lines {
    position: relative;
    display: block;
    width: 20px;
    height: 14px;
  }

  .burger__line {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-black);
    transition:
      translate 0.2s var(--ease-out),
      rotate 0.2s var(--ease-out),
      opacity 0.15s linear;
  }

  .burger__line:nth-child(1) {
    top: 0;
  }

  .burger__line:nth-child(2) {
    top: 6px;
  }

  .burger__line:nth-child(3) {
    top: 12px;
  }

  .burger[aria-expanded="true"] {
    background: var(--color-brand);
    border-color: var(--color-brand);
  }

  .burger[aria-expanded="true"] .burger__line:nth-child(1) {
    translate: 0 6px;
    rotate: 45deg;
  }

  .burger[aria-expanded="true"] .burger__line:nth-child(2) {
    opacity: 0;
  }

  .burger[aria-expanded="true"] .burger__line:nth-child(3) {
    translate: 0 -6px;
    rotate: -45deg;
  }

  .strip.checker {
    --checker-size: 10px;
    height: 10px;
  }

  .strip--rule {
    height: 5px;
    border-top: 1px solid var(--color-black);
    border-bottom: 1px solid var(--color-black);
  }

  /* Oscurece la página (y el vídeo del hero) mientras el menú está abierto. */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: rgb(10 10 10 / 0.6);
  }

  /*
   * El panel se superpone bajo la barra en vez de empujar la página. Su altura máxima
   * se ajusta a la pantalla real del móvil y, si no cabe, hace scroll interno.
   */
  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 1;
    max-height: calc(100vh - var(--header-height));
    max-height: calc(100svh - var(--header-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-bottom: var(--frame-width) solid var(--color-brand);
    background: var(--color-black);
    color: var(--color-paper);
    padding: var(--space-m) var(--gutter) var(--space-l);
  }

  .scrim[hidden],
  .panel[hidden] {
    display: none;
  }

  .panel ul {
    display: grid;
    gap: 0.25rem;
    margin: 0 0 var(--space-m);
    padding: 0;
    list-style: none;
  }

  .panel a[data-menu-link] {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid #2a2a2a;
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--title-s);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .panel a[data-menu-link]:hover,
  .panel a[data-menu-link]:focus-visible {
    color: var(--color-brand);
  }

  .panel__cta {
    width: 100%;
  }

  /*
   * Home (overlaid), todos los anchos: header fijo sobre el vídeo. El observer
   * añade `is-solid` cuando el hero deja de cortar la franja de la barra.
   */
  .site-header--overlaid {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
  }

  .site-header--overlaid .bar {
    background: rgb(0 0 0 / 0.2);
    transition: background-color 0.25s var(--ease-out);
  }

  .site-header--overlaid.is-solid,
  .site-header--overlaid.is-menu-open {
    background: var(--color-paper);
  }

  .site-header--overlaid.is-solid .bar,
  .site-header--overlaid.is-menu-open .bar {
    background: var(--color-paper);
  }

  /* Móvil: hamburguesa clara sobre el vídeo. */
  @media (max-width: 61.99rem) {
    .site-header--overlaid .burger {
      background: transparent;
      border-color: var(--color-paper);
    }

    .site-header--overlaid .burger__line {
      background: var(--color-paper);
    }

    .site-header--overlaid.is-solid .burger,
    .site-header--overlaid.is-menu-open .burger {
      background: var(--color-paper);
      border-color: var(--color-black);
    }

    .site-header--overlaid.is-solid .burger__line,
    .site-header--overlaid.is-menu-open .burger__line {
      background: var(--color-black);
    }

    .site-header--overlaid .burger[aria-expanded="true"],
    .site-header--overlaid.is-solid .burger[aria-expanded="true"],
    .site-header--overlaid.is-menu-open .burger[aria-expanded="true"] {
      background: var(--color-brand);
      border-color: var(--color-brand);
    }

    .site-header--overlaid .burger[aria-expanded="true"] .burger__line,
    .site-header--overlaid.is-solid .burger[aria-expanded="true"] .burger__line,
    .site-header--overlaid.is-menu-open .burger[aria-expanded="true"] .burger__line {
      background: var(--color-black);
    }
  }

  @media (min-width: 62rem) {
    .nav-desktop,
    .phone {
      display: block;
    }

    .burger,
    .scrim,
    .panel {
      display: none;
    }

    .site-header--overlaid .nav-desktop a,
    .site-header--overlaid .phone {
      color: var(--color-paper);
    }

    .site-header--overlaid .nav-desktop a:hover,
    .site-header--overlaid .phone:hover {
      border-bottom-color: var(--color-black);
      background: var(--color-brand);
      color: var(--color-black);
    }

    .site-header--overlaid.is-solid .nav-desktop a,
    .site-header--overlaid.is-solid .phone {
      color: inherit;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger__line {
      transition: none;
    }

    .site-header--overlaid .bar,
    .brand :global(.brand__full),
    .brand :global(.brand__icon) {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  // Si el script volviera a ejecutarse, el header ya inicializado no repite listeners.
  if (header && header.dataset.menuReady !== "true") {
    header.dataset.menuReady = "true";

    const toggle = header.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const panel = header.querySelector<HTMLElement>("[data-menu-panel]");
    const scrim = header.querySelector<HTMLElement>("[data-menu-scrim]");
    const label = toggle?.querySelector<HTMLElement>("[data-menu-label]");
    const overlaid = header.hasAttribute("data-header-overlaid");
    const desktop = window.matchMedia("(min-width: 62rem)");
    const hero = document.querySelector<HTMLElement>("[data-hero]");

    let heroInTopBand = true;
    let compacted = false;

    const COMPACT_ON = 16;
    const COMPACT_OFF = 4;

    const isOpen = () => toggle?.getAttribute("aria-expanded") === "true";

    /**
     * El hero «está en la zona superior» mientras su caja corta la franja que ocupa
     * el header. `rootMargin` superior negativo recorta el viewport a partir del
     * borde inferior de la barra: no es un umbral de `scrollY`.
     */
    const measureHeroInTopBand = () => {
      if (!hero) return false;
      return hero.getBoundingClientRect().bottom > header.offsetHeight;
    };

    const applyAppearance = () => {
      if (!overlaid) {
        header.classList.remove("is-solid");
        header.classList.remove("is-compacted");
        return;
      }
      header.classList.toggle("is-solid", !heroInTopBand || isOpen());
      header.classList.toggle("is-compacted", compacted);
    };

    /**
     * Compacta al primer scroll y solo recupera el wordmark cerca de 0, con
     * holgura para que 1–2 px no hagan oscilar el estado.
     */
    const applyCompact = () => {
      if (!overlaid) return;
      const y = window.scrollY;
      if (!compacted && y > COMPACT_ON) compacted = true;
      else if (compacted && y < COMPACT_OFF) compacted = false;
      header.classList.toggle("is-compacted", compacted);
    };

    const setOpen = (open: boolean) => {
      if (!toggle || !panel) return;
      toggle.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
      if (scrim) scrim.hidden = !open;
      if (label) label.textContent = open ? "Cerrar menú" : "Abrir menú";
      header.classList.toggle("is-menu-open", open);
      applyAppearance();
    };

    if (toggle && panel) {
      toggle.addEventListener("click", () => setOpen(!isOpen()));

      panel.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a")) setOpen(false);
      });

      document.addEventListener("pointerdown", (event) => {
        if (!isOpen()) return;
        const target = event.target as Node;
        if (panel.contains(target) || toggle.contains(target)) return;
        setOpen(false);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !isOpen()) return;
        setOpen(false);
        toggle.focus();
      });

      desktop.addEventListener("change", (event) => {
        if (event.matches && isOpen()) setOpen(false);
        applyAppearance();
      });
    }

    if (overlaid && hero && "IntersectionObserver" in window) {
      const connect = () => {
        const top = header.offsetHeight;
        return new IntersectionObserver(
          ([entry]) => {
            if (!entry) return;
            heroInTopBand = entry.isIntersecting;
            applyAppearance();
          },
          { root: null, threshold: 0, rootMargin: `-${top}px 0px 0px 0px` },
        );
      };

      let observer = connect();
      observer.observe(hero);

      heroInTopBand = measureHeroInTopBand();
      applyAppearance();

      window.addEventListener("pageshow", () => {
        heroInTopBand = measureHeroInTopBand();
        applyCompact();
        applyAppearance();
      });

      window.addEventListener("scroll", applyCompact, { passive: true });
      applyCompact();

      desktop.addEventListener("change", () => {
        observer.disconnect();
        observer = connect();
        observer.observe(hero);
        heroInTopBand = measureHeroInTopBand();
        applyAppearance();
      });
    }
  }
</script>
